{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptPocket",
  "version": "1.1.0",
  "identifier": "com.promptpocket.desktop",
  "build": {
    "beforeDevCommand": "pnpm exec vite --config desktop/vite.config.ts",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "pnpm desktop:build",
    "frontendDist": "../release/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "PromptPocket",
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "你的本地提示词库",
    "longDescription": "分类整理、快速搜索并一键复制提示词，数据仅保存在本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"]
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
